# Example environment for the AI Financial Assistant.
#
# Copy to .env and fill in real values. .env is git-ignored and must never be
# committed. No real secret belongs in this file.
#
# Required in every non-development environment (each one fails closed when
# unset, so the app starts but the affected capability refuses to work):
#   SECRET_KEY, SECRET_ENCRYPTION_KEY, and at least one LLM endpoint
#   (LLM_API_KEY + LLM_MODEL) for the shared fallback pool.

APP_NAME=AI Financial Assistant
APP_ENV=development
DEBUG=True
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/financial_assistant

# --- Authentication ---------------------------------------------------------
# SECRET_KEY signs JWTs. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty means token operations fail closed (RuntimeError -> HTTP 503/500).
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Secret encryption (broker LLM API keys at rest) ------------------------
# SECRET_ENCRYPTION_KEY is a urlsafe-base64 Fernet key. Generate one, e.g.:
#   python -c "from app.core.encryption import generate_encryption_key; print(generate_encryption_key())"
# Empty means credential storage is unavailable (HTTP 503) rather than storing
# keys in a recoverable form. Never log it, never commit it, and keep a copy:
# losing it makes every stored broker API key unreadable.
SECRET_ENCRYPTION_KEY=

# --- Shared (fallback) LLM endpoint ----------------------------------------
# Used by the free-pool when a broker has no active configuration of its own.
# Outside development LLM_BASE_URL must be https, and the host must resolve to
# a public address (loopback/private/link-local/metadata addresses are refused).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# --- OpenRouter (DEVELOPMENT/TEST FREE TIER ONLY) ---------------------------
# The real LLM the development chat uses, behind the SAME OpenAI-compatible
# provider as the endpoint above, so a paid production provider can replace it
# later without touching the agent. It is served inside APP_ENV=development only:
# a key set in any other environment is ignored, so a free-tier credential can
# never serve a broker's customers. ONE free model is pinned deliberately - no
# dynamic model pool, no paid routing - so development answers are reproducible
# and cost nothing.
#
# Get a free key from https://openrouter.ai. An empty key leaves this provider
# out of the pool (the request fails closed with 503, it never degrades). The key
# is never logged, never returned in a response and never rendered into a prompt.
# Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Economic calendar source -----------------------------------------------
# The economic calendar is MANDATORY for every Agent request, so this names the
# one source the deployment serves. An unusable selection fails closed (503)
# with a generic detail; it never degrades to a different source.
#
#   auto             (default) - the environment decides. In development: the
#                                QuantGist free tier when QUANTGIST_API_KEY is
#                                set, otherwise the deterministic placeholder.
#                                Anywhere else: refuses, because no production
#                                calendar source is configured.
#   development_fake            - the deterministic placeholder events.
#   quantgist                   - the QuantGist free tier (delayed, small quota).
#   production                  - the production vendor slot. No production vendor
#                                 is implemented yet, so selecting it refuses
#                                 (503) until one is registered: it exists so a
#                                 production deployment fails loudly instead of
#                                 silently serving development data.
#
# development_fake and quantgist are served inside APP_ENV=development only;
# selecting either anywhere else refuses (503).
ECONOMIC_CALENDAR_SOURCE=auto

# --- News source (fundamental intelligence) ---------------------------------
# Which news source this deployment serves. News is fundamental context for the
# Agent, so the selection is explicit and never degrades to another source.
#
# Unlike the calendar, an environment with NO news source is a supported state:
# the fundamental context then reports news as explicitly unavailable (with the
# reason) instead of pretending there is no news. An EXPLICITLY selected source
# that cannot be served refuses (503) rather than falling back.
#
#   auto             (default) - the environment decides. In development: the
#                                Alpha Vantage feed when ALPHA_VANTAGE_API_KEY is
#                                set, otherwise the deterministic placeholder.
#                                Anywhere else: no news source is configured, so
#                                news is reported unavailable.
#   development_fake            - the deterministic placeholder news items.
#   alphavantage                - the Alpha Vantage News & Sentiment feed
#                                 (development/test only; a key is required).
#   production                  - the production vendor slot. No production news
#                                 vendor is implemented, so selecting it refuses
#                                 (503) until one is registered: it exists so a
#                                 production deployment fails loudly instead of
#                                 silently serving development data.
#
# development_fake and alphavantage are served inside APP_ENV=development only;
# selecting either anywhere else refuses (503), and a configured key alone never
# makes a non-development deployment serve Alpha Vantage.
NEWS_SOURCE=auto
# Hard cap on news items retrieved and rendered per request (the news service
# also rejects an unbounded excerpt rather than truncating silently).
NEWS_MAX_ITEMS=20

# --- Alpha Vantage news source (DEVELOPMENT/TEST SOURCE ONLY) ---------------
# "auto" in development selects it when this key is set, and NEWS_SOURCE can also
# name it explicitly. It is a temporary development/test stand-in, NOT this
# project's commercial vendor: the free tier has a small daily quota and its terms
# are for personal use, so its provenance marker
# ("alphavantage-free-development") is returned as data_source and carried into
# the agent prompt - nothing built from it may be presented as live/production
# news data. An empty key with NEWS_SOURCE=alphavantage is an unconfigured source
# and refuses (503); no environment other than development serves it.
#
# Never commit a real key and never log it. The vendor requires the key as a query
# parameter, so the adapter installs a redaction filter on the HTTP client's
# logger: enabling INFO logging there must not put the key into a log line.
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
# Per-request HTTP timeout, in seconds.
ALPHA_VANTAGE_TIMEOUT_SECONDS=15

# --- Economic calendar (DEVELOPMENT/TEST SOURCE ONLY) ----------------------
# When the source above resolves to QuantGist (auto with this key set in
# development, or ECONOMIC_CALENDAR_SOURCE=quantgist), the QuantGist free tier
# is the economic-calendar source. It is a temporary development/test stand-in,
# NOT the project's commercial vendor: its free plan serves data delayed by 15
# minutes and is capped at 100 requests/day. Its provenance marker
# ("quantgist-free-development") is returned as data_source, so nothing built
# from it can be presented as live market data.
#
# An empty key with ECONOMIC_CALENDAR_SOURCE=quantgist is an unconfigured
# source and refuses (503). Any environment other than development fails closed
# (503) rather than serving placeholder or delayed data to a broker's customers.
# Never commit a real key and never log it. Keys are issued at https://quantgist.com
QUANTGIST_API_KEY=
QUANTGIST_BASE_URL=https://api.quantgist.com/v1
# Per-request HTTP timeout, in seconds.
QUANTGIST_TIMEOUT_SECONDS=15

# --- MetaTrader 5 terminal session ------------------------------------------
# MT5 authenticates ONE account per process on one live terminal connection, so
# every MT5 read is serialized and exactly ONE application process may own a
# terminal: two processes pointed at the same terminal would share its single
# current account, which is a cross-tenant leak. Reads are authenticated per
# tenant from the database (the user's login/server and encrypted INVESTOR
# password), and the terminal's ACTUAL account is verified against the requested
# one before every read; a session that cannot be confirmed fails closed (503).
#
# Which terminal executable to drive. Empty means "let the package find it" (the
# development behaviour). Set it when more than one terminal is installed, so the
# choice is deterministic, and it is what a future worker-per-account topology
# needs.
MT5_TERMINAL_PATH=
# How long one initialize()/login() may block, in seconds. An authentication that
# hangs holds the process-wide session lock, so every tenant waits behind it;
# this bounds that wait. MT5's own default is 60 s. 0 leaves the package default.
MT5_TIMEOUT_SECONDS=10

# --- Outbound LLM data policy ----------------------------------------------
# Which classes of customer financial data may be rendered into an external
# prompt. All true reproduces the original behaviour; each false withholds one
# data class. Set these deliberately per environment/broker agreement.
LLM_SEND_TRADE_HISTORY=True
LLM_SEND_ACCOUNT_BALANCES=True
LLM_SEND_POSITION_PRICING=True

# --- Agent limits -----------------------------------------------------------
# Per authenticated user (database User.id) per UTC day, checked before any MT5
# read or LLM call. Enforced in-process (per worker) for the current
# single-process deployment.
AGENT_DAILY_REQUEST_LIMIT=50
# Maximum characters accepted in the POST /agent "message" field (422 above it).
AGENT_MAX_MESSAGE_LENGTH=2000
# Maximum executed trades rendered into one prompt (most recent kept, the number
# omitted is stated explicitly in the prompt).
AGENT_MAX_PROMPT_TRADES=50
# Total rendered prompt size ceiling. The trade block is dropped first, then the
# fundamental-intelligence block, then the economic-calendar block; beyond that
# the request is refused rather than sent unbounded.
AGENT_MAX_PROMPT_CHARS=24000

# --- Login brute-force protection (in-process) ------------------------------
# Failed attempts allowed per client IP and per submitted username inside the
# window before the login endpoint answers a generic 429.
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_SECONDS=300

# --- Unrecognised keys ------------------------------------------------------
# A key that matches no setting in app/core/config.py is IGNORED rather than
# fatal: the app starts and logs a warning naming the key (its value is never
# read or printed). This is deliberate — an extra key is usually a mistyped
# setting name, and settings often hold credentials, which the startup failure
# would otherwise echo verbatim. Keep this file to exactly the names defined in
# app/core/config.py, and never park a local-only credential here under a name
# the application does not define.
